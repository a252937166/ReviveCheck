{
  "name": "revivecheck",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Check Portaldot V3 releases against the chain, approve them on-chain, and assess promotion to V3 Live",
  "exports": {
    ".": "./lib/service.js",
    "./policy": "./lib/policy.js",
    "./entry": "./lib/entry.js",
    "./current": "./lib/current.js",
    "./decision": "./lib/decision.js",
    "./service": "./lib/service.js",
    "./report": "./lib/report.js",
    "./registry": "./lib/registry.js",
    "./tokenlist": "./lib/tokenlist.js",
    "./networks": "./lib/networks.js",
    "./chain": "./lib/chain.js",
    "./evidence": "./lib/evidence.js",
    "./plan": "./lib/plan.js",
    "./demo": "./lib/demo.js",
    "./lib/*": "./lib/*",
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "contracts/*.sol",
    "contracts/deployed",
    "mcp",
    "scripts/revivecheck.js",
    "public/lifecycle/reference.json",
    "public/lifecycle/registry.json",
    "docs/API.md",
    "docs/POLICY.md",
    "docs/INTEGRATION.md",
    "docs/LIBRARY.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "revivecheck": "scripts/revivecheck.js",
    "revivecheck-mcp": "mcp/server.js"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test test/*.test.js",
    "wallet:create": "node scripts/create-wallet.js",
    "check:live": "node scripts/check-live.js",
    "mcp": "node mcp/server.js",
    "rc": "node scripts/revivecheck.js",
    "catalog": "node examples/token-catalog/catalog.js",
    "release:status": "node scripts/release-status.js",
    "package:verify": "node scripts/verify-artifact.mjs",
    "hosting:manifest": "node scripts/hosting-manifest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/hashes": "^2.4.0",
    "@polkadot/api": "^16.4.8",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "ethers": "^6.17.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ethereumjs/vm": "^10.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@polkadot/extension-dapp": "^0.64.1",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solc": "^0.8.24",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
